<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday Lovie</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;600&family=Great+Vibes&display=swap');

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #08080a;
      font-family: 'Montserrat', sans-serif;
      color: #fff;
    }

    .bg-glow {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at 50% 45%, rgba(232, 97, 157, 0.06) 0%, rgba(8, 8, 10, 1) 70%);
      transition: background 1.5s ease;
      pointer-events: none;
      z-index: 0;
    }

    .bg-glow.celebrating {
      background: radial-gradient(circle at 50% 45%, rgba(232, 97, 157, 0.18) 0%, rgba(212, 175, 55, 0.08) 45%, rgba(8, 8, 10, 1) 80%);
    }

    #stars {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
    }

    .star {
      position: absolute;
      background: #ffffff;
      border-radius: 50%;
      animation: twinkle var(--dur, 3s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.1; transform: scale(0.8); }
      50% { opacity: 0.85; transform: scale(1.4); }
    }

    #scene {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 2;
    }

    .cake-stage {
      position: relative;
      width: 220px;
      height: 170px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .candle-container {
      position: absolute;
      left: 50%;
      top: 85px;
      transform: translate(-50%, -400px);
      opacity: 0;
      animation: candleLand 0.7s 6.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
      cursor: pointer;
      z-index: 10;
    }

    @keyframes candleLand {
      0% { transform: translate(-50%, -350px); opacity: 0; }
      100% { transform: translate(-50%, -100%); opacity: 1; }
    }

    .candle {
      position: relative;
      width: 6px;
      height: 36px;
      background: linear-gradient(to right, #ffffff, #f7e8ef, #ffffff);
      border-radius: 3px;
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
    }

    .candle::before,
    .candle::after {
      content: "";
      position: absolute;
      width: 100%;
      height: 2px;
      background: rgba(232, 97, 157, 0.45);
    }

    .candle::before { top: 30%; }
    .candle::after { top: 60%; }

    .wick {
      position: absolute;
      top: -4px;
      left: 50%;
      transform: translateX(-50%);
      width: 1.5px;
      height: 4px;
      background: #444;
      border-radius: 1px;
    }

    .flame-group {
      position: absolute;
      top: -22px;
      left: 50%;
      transform: translateX(-50%);
      width: 12px;
      height: 22px;
      pointer-events: auto;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .flame-group.extinguished {
      transform: translateX(-50%) scale(0);
      opacity: 0;
      pointer-events: none;
    }

    .fuego {
      position: absolute;
      inset: 0;
      border-radius: 50% 50% 35% 35%;
      background: radial-gradient(ellipse at bottom, rgba(255, 245, 150, 0.95) 0%, rgba(255, 140, 0, 0.8) 50%, rgba(255, 50, 0, 0) 100%);
      box-shadow: 0 0 12px 3px rgba(255, 200, 80, 0.7),
                  0 0 25px 8px rgba(232, 97, 157, 0.3);
      animation: flameFlicker 1.2s 7.3s ease-in-out infinite alternate;
      opacity: 0;
    }

    @keyframes flameFlicker {
      0% { transform: scale(1) rotate(-1deg); opacity: 0.95; }
      50% { transform: scale(1.08, 0.95) rotate(1.5deg); opacity: 1; }
      100% { transform: scale(0.94, 1.05) rotate(-1deg); opacity: 0.9; }
    }

    .fire-halo {
      position: absolute;
      top: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 220, 130, 0.35) 0%, rgba(232, 97, 157, 0.15) 50%, transparent 75%);
      pointer-events: none;
      animation: haloPulse 2s 7.3s ease-in-out infinite;
      opacity: 0;
    }

    @keyframes haloPulse {
      0%, 100% { opacity: 0.4; transform: translateX(-50%) scale(0.9); }
      50% { opacity: 0.8; transform: translateX(-50%) scale(1.25); }
    }

    .smoke-particle {
      position: absolute;
      top: -10px;
      left: 50%;
      width: 8px;
      height: 8px;
      background: rgba(220, 210, 220, 0.6);
      border-radius: 50%;
      filter: blur(3px);
      pointer-events: none;
      animation: smokeRise 2.5s ease-out forwards;
    }

    @keyframes smokeRise {
      0% { transform: translate(-50%, 0) scale(0.6); opacity: 0.8; }
      50% { opacity: 0.5; }
      100% { transform: translate(calc(-50% + var(--dx)), -80px) scale(3.5); opacity: 0; }
    }

    #cake {
      display: block;
      position: absolute;
      top: -325px;
      left: 10px;
      width: 200px;
      height: 500px;
      filter: drop-shadow(0 0 20px rgba(232, 97, 157, 0.25));
      animation: cakeGentleFloat 4s 7.5s ease-in-out infinite;
      transition: filter 0.8s ease;
    }

    @keyframes cakeGentleFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }

    #cake.celebrating {
      filter: drop-shadow(0 0 35px rgba(232, 97, 157, 0.65)) drop-shadow(0 0 15px rgba(212, 175, 55, 0.3));
    }

    .initial-text {
      margin-top: 24px;
      text-align: center;
      opacity: 0;
      animation: textAppear 1.2s 8s ease-out forwards;
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .initial-text.hide {
      display: none;
    }

    .initial-text h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: 2px;
      color: #fce4ec;
      text-transform: lowercase;
    }

    .initial-text .name {
      font-family: 'Montserrat', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 3px;
      color: #e8619d;
      margin-top: 4px;
      text-transform: uppercase;
    }

    @keyframes textAppear {
      to { opacity: 0.9; }
    }

    .celebration-text {
      margin-top: 20px;
      text-align: center;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 1.2s ease, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .celebration-text.active {
      opacity: 1;
      transform: translateY(0);
    }

    .celeb-greeting {
      font-family: 'Great Vibes', cursive;
      font-size: clamp(2.5rem, 6vw, 4.2rem);
      color: #ffffff;
      text-shadow: 0 0 20px rgba(232, 97, 157, 0.75),
                   0 0 35px rgba(212, 175, 55, 0.4);
      line-height: 1.1;
    }

    .celeb-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      font-weight: 600;
      letter-spacing: 6px;
      color: #ffd700;
      text-transform: uppercase;
      margin-top: 6px;
      text-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
    }

    .celeb-message {
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(0.75rem, 2vw, 0.95rem);
      font-weight: 300;
      letter-spacing: 3px;
      color: #fce4ec;
      margin-top: 14px;
      opacity: 0.9;
    }

    .music-subtitle {
      margin-top: 18px;
      max-width: 420px;
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(0.65rem, 1.8vw, 0.8rem);
      font-weight: 300;
      line-height: 1.6;
      letter-spacing: 1px;
      color: rgba(252, 228, 236, 0.8);
    }

    .music-subtitle span {
      color: #ffd700;
      font-weight: 600;
    }

    .music-button {
      margin-top: 18px;
      padding: 10px 20px;
      border: 1px solid rgba(232, 97, 157, 0.8);
      border-radius: 30px;
      background: rgba(232, 97, 157, 0.12);
      color: #fce4ec;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.72rem;
      letter-spacing: 1.5px;
      cursor: pointer;
      transition: all 0.3s ease;
      pointer-events: auto;
    }

    .music-button:hover {
      background: rgba(232, 97, 157, 0.35);
      border-color: #ffd700;
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 0 18px rgba(232, 97, 157, 0.4);
    }

    .music-button.playing {
      border-color: #ffd700;
      color: #ffd700;
    }

    #confetti-canvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 50;
    }

    .starlight {
      position: fixed;
      border-radius: 50%;
      pointer-events: none;
      z-index: 55;
      animation: starlightFade 1.2s ease-out forwards;
    }

    @keyframes starlightFade {
      0% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(0.2) translate(var(--mx), var(--my)); }
    }
  </style>
</head>
