    <div class="initial-text">
      <h1>Happy Birthday</h1>
      <div class="name">Lovie</div>
    </div>

    <div class="celebration-text" id="celebrationText">
      <div class="celeb-greeting">Happy Birthday</div>
      <div class="celeb-name">Lovie</div>
      <div class="celeb-message">May your day be as beautiful as you are.</div>

      <div class="music-subtitle">
        Now playing: <span>Feels</span> — Calvin Harris ft. Pharrell Williams,
        Katy Perry & Big Sean
      </div>

      <button id="musicButton" class="music-button">♫ Play birthday music</button>

      <audio id="birthdayMusic" preload="auto" loop>
        <source src="feels.mp3" type="audio/mpeg">
        Your browser does not support the audio element.
      </audio>
    </div>
  </div>

  <script>
    const bgGlow = document.getElementById('bgGlow');
    const candleTrigger = document.getElementById('candleTrigger');
    const flameGroup = document.getElementById('flameGroup');
    const cake = document.getElementById('cake');
    const celebrationText = document.getElementById('celebrationText');
    const stars = document.getElementById('stars');

    function createStar() {
      const star = document.createElement('span');
      star.className = 'star';
      const size = Math.random() * 3 + 2;
      star.style.width = size + 'px';
      star.style.height = size + 'px';
      star.style.left = Math.random() * 100 + '%';
      star.style.top = Math.random() * 100 + '%';
      star.style.setProperty('--dur', (Math.random() * 3 + 2) + 's');
      star.style.setProperty('--delay', (Math.random() * 2) + 's');
      stars.appendChild(star);
    }

    for (let i = 0; i < 120; i++) {
      createStar();
    }

    const musicButton = document.getElementById('musicButton');
    const birthdayMusic = document.getElementById('birthdayMusic');

    let musicPlaying = false;

    musicButton.addEventListener('click', async () => {
      if (!musicPlaying) {
        try {
          birthdayMusic.volume = 1;
          await birthdayMusic.play();
          musicButton.textContent = '♫ Music playing';
          musicButton.classList.add('playing');
          musicPlaying = true;
        } catch (error) {
          console.log('Audio blocked until interaction:', error);
          musicButton.textContent = '♫ Tap again to play';
        }
      } else {
        birthdayMusic.pause();
        birthdayMusic.currentTime = 0;
        musicButton.textContent = '♫ Play birthday music';
        musicButton.classList.remove('playing');
        musicPlaying = false;
      }
    });

    setTimeout(() => {
      bgGlow.classList.add('celebrating');
      cake.classList.add('celebrating');
      celebrationText.classList.add('active');
    }, 8200);

    candleTrigger.addEventListener('click', () => {
      flameGroup.classList.toggle('extinguished');

      if (!flameGroup.classList.contains('extinguished')) {
        const particles = 8;
        for (let i = 0; i < particles; i++) {
          const puff = document.createElement('span');
          puff.className = 'smoke-particle';
          puff.style.setProperty('--dx', ((Math.random() * 60) - 30) + 'px');
          puff.style.left = '50%';
          puff.style.top = '-10px';
          candleTrigger.appendChild(puff);

          setTimeout(() => puff.remove(), 2500);
        }
      }
    });

    function createBurst(x, y) {
      const burst = document.createElement('span');
      burst.className = 'starlight';
      burst.style.left = x + 'px';
      burst.style.top = y + 'px';
      burst.style.width = '12px';
      burst.style.height = '12px';
      burst.style.background = 'radial-gradient(circle, rgba(255,255,255,1) 0%, rgba(255,215,0,1) 30%, rgba(232,97,157,0.6) 70%, transparent 100%)';
      burst.style.setProperty('--mx', (Math.random() * 120 - 60) + 'px');
      burst.style.setProperty('--my', (Math.random() * 120 - 60) + 'px');
      document.body.appendChild(burst);
      setTimeout(() => burst.remove(), 1200);
    }

    let confettiCanvas = document.getElementById('confetti-canvas');
    let ctx = confettiCanvas.getContext('2d');
    let confetti = [];
    let colors = ['#f7d154', '#ff8fcf', '#8de2ff', '#b9f27c', '#fff'];

    function resizeCanvas() {
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    function makeConfetti() {
      confetti = Array.from({ length: 140 }, () => ({
        x: Math.random() * confettiCanvas.width,
        y: Math.random() * -confettiCanvas.height,
        r: Math.random() * 6 + 4,
        dx: (Math.random() - 0.5) * 2.5,
        dy: Math.random() * 2 + 1.2,
        rot: Math.random() * Math.PI,
        color: colors[Math.floor(Math.random() * colors.length)],
        drift: (Math.random() - 0.5) * 0.6
      }));
    }
    makeConfetti();

    function drawConfetti() {
      ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
      confetti.forEach(p => {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 1.7);
        ctx.restore();

        p.x += p.dx;
        p.y += p.dy;
        p.rot += 0.08;
        p.x += p.drift;

        if (p.y > confettiCanvas.height + 10) {
          p.y = -10;
          p.x = Math.random() * confettiCanvas.width;
        }
      });

      requestAnimationFrame(drawConfetti);
    }
    drawConfetti();

    setInterval(() => {
      const x = Math.random() * window.innerWidth;
      const y = Math.random() * window.innerHeight * 0.5;
      createBurst(x, y);
    }, 250);

    setTimeout(() => {
      bgGlow.classList.add('celebrating');
      cake.classList.add('celebrating');
      celebrationText.classList.add('active');
    }, 8000);
  </script>
